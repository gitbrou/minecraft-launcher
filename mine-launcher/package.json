{
  "name": "mine-launcher",
  "private": true,
  "version": "2.0.0",
  "description": "Modern Minecraft Launcher built with Electron + React + TypeScript",
  "author": {
    "name": "gitbrou",
    "email": "gitbrou@users.noreply.github.com"
  },
  "homepage": "https://github.com/gitbrou/minecraft-launcher",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "compile": "tsc && vite build",
    "test": "vitest run",
    "build": "tsc && vite build && electron-builder --publish never",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "android:sync": "npm run compile && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "adm-zip": "^0.6.1",
    "electron-updater": "6.8.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "skinview3d": "^3.4.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.minelauncher.app",
    "productName": "Mine Launcher",
    "protocols": [
      {
        "name": "Mine Launcher Import",
        "schemes": [
          "minelauncher"
        ]
      }
    ],
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mine Launcher",
      "artifactName": "${name}-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "maintainer": "gitbrou <gitbrou@users.noreply.github.com>",
      "icon": "public/icon.png",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.games",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gitbrou",
        "repo": "minecraft-launcher"
      }
    ]
  }
}
